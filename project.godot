config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Qrokkun"
config/description="A tiny 2D bullet-dodging survival game. Made by Grok Bot. Tribute to Tokkun 99."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.png"
run/max_fps=60

[autoload]

GameState="*res://scripts/game_state.gd"

[debug]

gdscript/warnings/untyped_declaration=0

[display]

window/size/viewport_width=320
window/size/viewport_height=240
window/size/window_width_override=960
window/size/window_height_override=720
window/size/resizable=true
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"
window/vsync/vsync_mode=1

[gui]

theme/default_font_antialiasing=0
theme/default_font_subpixel_positioning=0
theme/default_font_hinting=0
theme/default_font_multichannel_signed_distance_field=false

[layer_names]

2d_physics/layer_1="player"
2d_physics/layer_2="bullets"

[physics]

common/physics_ticks_per_second=60
common/physics_interpolation=false

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.0705882, 0.0470588, 0.109804, 1)
